#!/usr/bin/env bash

# Command line wrapper for the functions in terminal_registry

set -euo pipefail

this_script_dir="$(dirname "$(realpath "$0")")"
plugin_dir=$(realpath "$this_script_dir/..")

set +e
expression="$(nvim -l "$this_script_dir"/get-expr.lua "$@" 2>&1)"
exit_code="$?"
if [ "$exit_code" -ne 0 ]; then
  echo "$expression" >&2
  exit "$exit_code"
fi
set -e

exec nvim --headless --server "$NVIM" --remote-expr "$expression"
